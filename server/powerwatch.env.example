PW_SITE=casa

# --- pulse dall'ESP32 ---
PW_PULSE_PORT=47999
PW_TOKEN=cambiami-generala-con-openssl-rand-hex-16
# secondi senza pulse prima di dichiarare il blackout
PW_TIMEOUT=90
# secondi di pulse continui prima di dichiarare il ripristino
PW_RESTORE_CONFIRM=20

# --- dashboard ---
PW_HTTP_PORT=8080
# Chiave d'accesso alla dashboard. Generala con: openssl rand -hex 16
# Lasciala vuota SOLO se la dashboard non e' raggiungibile da internet.
PW_UI_TOKEN=

# --- Web Push (canale primario) ---
# Generale una volta con: python3 gen_vapid.py
PW_VAPID_PRIVATE_KEY=
PW_VAPID_PUBLIC_KEY=
PW_VAPID_SUBJECT=mailto:tua.mail@example.com
# se il telefono e' offline, la push attende fino a 24h
PW_PUSH_TTL=86400
# Promemoria push finche' il blackout dura (secondi, 0 disattiva).
# Solo push: su email un blackout lungo diventerebbe decine di messaggi.
PW_REMIND_EVERY=1800

# Link alla dashboard in coda alle email (vuoto = nessun link)
PW_DASHBOARD_URL=https://powerwatch.example.com

# --- email (ridondanza) ---
# iCloud: smtp.mail.me.com:587 starttls, con una password per app
PW_SMTP_HOST=smtp.mail.me.com
PW_SMTP_PORT=587
PW_SMTP_TLS=starttls
PW_SMTP_USER=tuo.indirizzo@icloud.com
PW_SMTP_PASS=app-specific-password
PW_MAIL_FROM=tuo.indirizzo@icloud.com
# Piu' destinatari: separali con la virgola, es.
# PW_MAIL_TO=io@icloud.com,partner@example.com,vicino@example.com
PW_MAIL_TO=tuo.indirizzo@icloud.com
